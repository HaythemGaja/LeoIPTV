<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0: focused button fills with the accent and gets a light outline,
     so D-pad focus is obvious. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/leo_accent" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/leo_accent_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/leo_card" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
