<?xml version="1.0" encoding="utf-8"?>
<!-- Card: focused = brighter fill + accent outline (scale is done in code). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/leo_card_focus" />
            <stroke android:width="2dp" android:color="@color/leo_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/leo_card_focus" />
            <stroke android:width="2dp" android:color="@color/leo_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/leo_card" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
