<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0 Browse: slim sidebar (nav + categories), main area with top bar
     (mode title + status + clock), a big hero that follows the focused
     card, the paged main row, then Continue Watching / Recently Added /
     Favorites rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/bg_gradient">
    <LinearLayout android:layout_width="216dp" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@drawable/panel_bg"
        android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="LEO IPTV" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/leo_accent" android:paddingLeft="8dp"
            android:paddingTop="6dp" android:paddingBottom="10dp" />
        <ListView android:id="@+id/b_sidebar" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:choiceMode="singleChoice" android:divider="@null"
            android:listSelector="@android:color/transparent" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <Button android:id="@+id/b_search" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:text="Search" android:textSize="15sp"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector"
                android:layout_marginRight="5dp" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/b_refresh" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:text="Refresh" android:textSize="15sp"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector"
                android:layout_marginLeft="5dp" android:focusable="true" android:focusableInTouchMode="true" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/b_row_label" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="@color/leo_text" />
                <TextView android:id="@+id/b_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="@color/leo_text_muted" android:paddingRight="14dp" />
                <TextView android:id="@+id/b_clock" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="15sp"
                    android:textColor="@color/leo_text_secondary" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="320dp"
                android:layout_marginTop="14dp">
                <ImageView android:id="@+id/b_backdrop" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:scaleType="centerCrop"
                    android:alpha="0.35" />
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/hero_scrim" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:padding="24dp">
                    <TextView android:id="@+id/b_hero_kicker" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/leo_accent"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/b_hero_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="32sp"
                        android:textStyle="bold" android:textColor="@color/leo_text"
                        android:paddingTop="6dp" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/b_hero_info" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="15sp"
                        android:textColor="@color/leo_text_muted" android:paddingTop="6dp"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/b_hero_epg" android:layout_width="match_parent"
                        android:layout_height="0dp" android:layout_weight="1"
                        android:textSize="15sp" android:textColor="@color/leo_text_secondary"
                        android:paddingTop="8dp" android:maxLines="3" android:ellipsize="end" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="right" android:paddingTop="10dp">
                        <Button android:id="@+id/b_hero_fav" android:layout_width="180dp"
                            android:layout_height="56dp" android:text="☆ Favorite" android:textSize="17sp"
                            android:textColor="@color/leo_text" android:background="@drawable/outline_button"
                            android:layout_marginRight="12dp"
                            android:focusable="true" android:focusableInTouchMode="true" />
                        <Button android:id="@+id/b_play" android:layout_width="220dp"
                            android:layout_height="56dp" android:text="▶ Play" android:textSize="19sp"
                            android:textStyle="bold" android:textColor="#04211C"
                            android:background="@drawable/accent_button"
                            android:focusable="true" android:focusableInTouchMode="true" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <TextView android:id="@+id/b_main_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:paddingTop="18dp" />
            <HorizontalScrollView android:id="@+id/b_row_scroll" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/b_row" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <TextView android:id="@+id/b_cw_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Continue Watching"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/leo_text"
                android:paddingTop="18dp" />
            <HorizontalScrollView android:id="@+id/b_cw_scroll" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/b_cw_row" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <TextView android:id="@+id/b_recent_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Recently Added"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/leo_text"
                android:paddingTop="18dp" android:visibility="gone" />
            <HorizontalScrollView android:id="@+id/b_recent_scroll" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="8dp" android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout android:id="@+id/b_recent_row" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <TextView android:id="@+id/b_fav_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Favorites"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/leo_text"
                android:paddingTop="18dp" />
            <HorizontalScrollView android:id="@+id/b_fav_scroll" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/b_fav_row" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
