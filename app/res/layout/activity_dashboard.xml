<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0: tiles are now a 2-column grid (same button IDs, so DashboardActivity
     is unchanged) with taller tiles and more breathing room. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/leo_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/dash_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="34sp" android:textStyle="bold"
            android:textColor="@color/leo_text" />
        <TextView android:id="@+id/dash_account" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="@color/leo_accent" android:paddingTop="4dp" android:paddingBottom="20dp" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="2" android:useDefaultMargins="true">
            <Button android:id="@+id/tile_live" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
            <Button android:id="@+id/tile_movies" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
            <Button android:id="@+id/tile_series" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
            <Button android:id="@+id/tile_guide" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
            <Button android:id="@+id/tile_fav" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
            <Button android:id="@+id/tile_search" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
            <Button android:id="@+id/tile_settings" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
            <Button android:id="@+id/tile_switch" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal" android:text="Switch User" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/leo_text" android:background="@drawable/button_selector" />
        </GridLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Continue Watching" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/leo_text" android:paddingTop="24dp" android:paddingBottom="8dp" />
        <LinearLayout android:id="@+id/cw_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Recent" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/leo_text" android:paddingTop="24dp" android:paddingBottom="8dp" />
        <LinearLayout android:id="@+id/recent_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
