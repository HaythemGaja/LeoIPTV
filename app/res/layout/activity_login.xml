<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="LEO IPTV" android:textSize="34sp" android:textStyle="bold"
            android:textColor="@color/leo_accent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Add your IPTV account or playlist to start"
            android:textSize="16sp" android:textColor="@color/leo_text_muted"
            android:paddingTop="4dp" android:paddingBottom="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/panel_bg" android:padding="20dp"
                android:layout_marginRight="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Xtream Codes" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="@color/leo_text" />
                <EditText android:id="@+id/et_x_name" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="Profile name" android:textSize="16sp"
                    android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
                    android:background="@color/leo_input_bg" android:padding="12dp" android:layout_marginTop="10dp" />
                <EditText android:id="@+id/et_x_host" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="Host, e.g. example.com:8080"
                    android:textSize="16sp" android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
                    android:background="@color/leo_input_bg" android:padding="12dp" android:layout_marginTop="8dp" />
                <EditText android:id="@+id/et_x_user" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="Username" android:textSize="16sp"
                    android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
                    android:background="@color/leo_input_bg" android:padding="12dp" android:layout_marginTop="8dp" />
                <EditText android:id="@+id/et_x_pass" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="Password" android:textSize="16sp"
                    android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
                    android:background="@color/leo_input_bg" android:padding="12dp" android:layout_marginTop="8dp"
                    android:inputType="textPassword" />
                <Button android:id="@+id/btn_save_xtream" android:layout_width="match_parent"
                    android:layout_height="52dp" android:text="Save Xtream account" android:textSize="17sp"
                    android:textStyle="bold" android:textColor="#04211C" android:background="@drawable/accent_button"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/panel_bg" android:padding="20dp"
                android:layout_marginLeft="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="M3U Playlist" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="@color/leo_text" />
                <EditText android:id="@+id/et_m_name" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="Profile name" android:textSize="16sp"
                    android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
                    android:background="@color/leo_input_bg" android:padding="12dp" android:layout_marginTop="10dp" />
                <EditText android:id="@+id/et_m_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="M3U URL, e.g. https://example.com/playlist.m3u"
                    android:textSize="16sp" android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
                    android:background="@color/leo_input_bg" android:padding="12dp" android:layout_marginTop="8dp" />
                <Button android:id="@+id/btn_save_m3u" android:layout_width="match_parent"
                    android:layout_height="52dp" android:text="Save M3U playlist" android:textSize="17sp"
                    android:textStyle="bold" android:textColor="#04211C" android:background="@drawable/accent_button"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/login_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textColor="@color/leo_accent" android:paddingTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Saved users" android:textSize="19sp" android:textStyle="bold"
            android:textColor="@color/leo_text" android:paddingTop="20dp" android:paddingBottom="8dp" />
        <LinearLayout android:id="@+id/saved_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Credentials are stored only on this device."
            android:textSize="13sp" android:textColor="@color/leo_text_muted" android:paddingTop="16dp" />
    </LinearLayout>
</ScrollView>
