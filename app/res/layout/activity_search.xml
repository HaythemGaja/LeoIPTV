<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_gradient" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Search" android:textSize="26sp" android:textStyle="bold"
        android:textColor="@color/leo_text" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="14dp" android:gravity="center_vertical">
        <EditText android:id="@+id/s_query" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp" android:hint="Channel, movie or series name"
            android:textSize="17sp" android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
            android:background="@color/leo_input_bg" android:padding="14dp" />
        <Button android:id="@+id/btn_search" android:layout_width="160dp"
            android:layout_height="56dp" android:text="Search" android:textSize="17sp"
            android:textStyle="bold" android:textColor="#04211C" android:background="@drawable/accent_button"
            android:layout_marginLeft="12dp" />
    </LinearLayout>
    <TextView android:id="@+id/s_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:textColor="@color/leo_text_muted" android:paddingTop="12dp" />
    <ListView android:id="@+id/s_results" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp"
        android:divider="@null" android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
