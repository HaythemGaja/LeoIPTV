<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/leo_bg" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Search" android:textSize="30sp" android:textStyle="bold"
        android:textColor="@color/leo_text" />
    <EditText android:id="@+id/s_query" android:layout_width="match_parent"
        android:layout_height="56dp" android:hint="Channel, movie or series name"
        android:textSize="17sp" android:textColor="@color/leo_text" android:textColorHint="@color/leo_text_muted"
        android:background="@color/leo_input_bg" android:padding="12dp" android:layout_marginTop="12dp" />
    <Button android:id="@+id/btn_search" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="Search" android:textSize="19sp"
        android:textColor="@color/leo_text" android:background="@drawable/button_selector"
        android:layout_marginTop="8dp" />
    <TextView android:id="@+id/s_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp"
        android:textColor="@color/leo_accent" android:paddingTop="12dp" />
    <ListView android:id="@+id/s_results" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp" />
</LinearLayout>
