<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2: the poster IS the card. The poster area fills the top of the card
     (sized in code: 2:3 for movies/series, square for live logos) and the
     initials tile only shows when there is no poster at all. Below it:
     name, group, Now/rating line, and a progress bar (Continue Watching). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card_selector"
    android:padding="8dp" android:focusable="true" android:focusableInTouchMode="true">
    <FrameLayout android:id="@+id/poster_box" android:layout_width="match_parent"
        android:layout_height="240dp">
        <TextView android:id="@+id/tile" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:textSize="34sp" android:textStyle="bold"
            android:textColor="@color/leo_text" />
        <ImageView android:id="@+id/logo" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/item_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold"
        android:textColor="@color/leo_text" android:paddingTop="8dp"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/item_group" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/leo_accent"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/item_now" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/leo_text_muted"
        android:maxLines="1" android:ellipsize="end" />
    <ProgressBar android:id="@+id/item_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp"
        android:max="100" android:layout_marginTop="6dp" android:visibility="gone" />
    <TextView android:id="@+id/item_progress_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:textColor="@color/leo_accent" android:maxLines="1" android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
