<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0 card: the poster/logo area fills the top (sized in code: 2:3 for
     movies/series, 16:9 for live logos); initials tile only when there is no
     image. Below: name, one meta line (Now / rating / group). The Continue
     Watching progress bar sits at the bottom edge of the poster. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card_selector"
    android:padding="8dp" android:focusable="true" android:focusableInTouchMode="true">
    <FrameLayout android:id="@+id/poster_box" android:layout_width="match_parent"
        android:layout_height="240dp">
        <TextView android:id="@+id/tile" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:textSize="30sp" android:textStyle="bold"
            android:textColor="@color/leo_text" />
        <ImageView android:id="@+id/logo" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter"
            android:visibility="gone" />
        <ProgressBar android:id="@+id/item_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_gravity="bottom" android:max="100"
            android:progressTint="@color/leo_accent"
            android:progressBackgroundTint="#40FFFFFF"
            android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/item_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/leo_text" android:paddingTop="8dp"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/item_now" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:textColor="@color/leo_text_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
