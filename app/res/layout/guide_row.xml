<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0: Now and Next are separate lines — the current program (g_epg) is
     white, the next one (g_next) is muted, so the current show stands out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/card_selector"
    android:focusable="true" android:focusableInTouchMode="true">
    <TextView android:id="@+id/g_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold"
        android:textColor="@color/leo_text" />
    <TextView android:id="@+id/g_epg" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="15sp"
        android:textColor="@color/leo_text" />
    <TextView android:id="@+id/g_next" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:textColor="@color/leo_text_muted" />
</LinearLayout>
