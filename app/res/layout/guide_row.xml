<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0 guide row: initials tile, channel name, Now (white) and Next (muted). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical"
    android:background="@drawable/card_selector"
    android:focusable="true" android:focusableInTouchMode="true">
    <TextView android:id="@+id/g_tile" android:layout_width="44dp" android:layout_height="44dp"
        android:gravity="center" android:textSize="15sp" android:textStyle="bold"
        android:textColor="@color/leo_text" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="14dp">
        <TextView android:id="@+id/g_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/leo_text" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/g_epg" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textColor="@color/leo_text_secondary" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/g_next" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/leo_text_muted" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
